# Copy this file to .env and fill in the key. .env is git-ignored. NEVER commit your real key.
GNANI_API_KEY=paste-your-key-from-app.gnani.ai-here

# --- optional tuning (defaults shown) ---
# STT_MODEL=prisma-v3.0
# STT_LANGS_HI=hi-IN,en-IN        # languages Prisma listens for in Hindi mode (Hinglish friendly)
# STT_LANGS_EN=en-IN,hi-IN
# STT_FORMAT_OVERRIDE=            # force one of verbatim|transcribe|codemix|transliterate for every field (for experiments)
# STT_USE_KEYTERMS=1              # send per-field hints; set 0 if Prisma rejects them
# TTS_MODEL=timbre-v2.5           # or timbre-v3.0 (beta). Voices are NOT shared between models
# TTS_VOICE=Nalini                # v2.5 Hindi voices: Nalini, Bhavna, Yashvi, Urmila, Deepak, ...
# TTS_SPEED=1.0                   # 0.85 to 1.15
# TTS_SAMPLE_RATE=24000

# --- credit protection for a public demo ---
# MAX_STT_CALLS=600               # whole server, until restart
# MAX_TTS_CALLS=2000
# MAX_STT_PER_SESSION=60
# MAX_SESSIONS=200
# SESSION_TTL_SECONDS=1800
# LOG_TRANSCRIPTS=0               # keep 0 in public: transcripts contain personal data
